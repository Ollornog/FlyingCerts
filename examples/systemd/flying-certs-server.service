# The broker's endpoint. Same reasoning as the agent's unit: check your own
# result with `systemd-analyze security flying-certs-server.service`.
#
# The broker holds two things that cannot be recreated — the ACME account key
# and the agent CA's key — so its state directory is the most valuable
# directory on the host. It is also the only thing this unit may write to.

[Unit]
Description=FlyingCerts broker
Documentation=https://github.com/Ollornog/FlyingCerts
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/flying-certs-server -config /etc/flying-certs/config.yaml serve
Restart=on-failure
RestartSec=10s

User=flying-certs
Group=flying-certs

NoNewPrivileges=yes
# Only if it listens below port 1024. On a port above that, drop both lines.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible

# The account key, the certificates, the agent CA, the audit log. Nothing else.
StateDirectory=flying-certs
LogsDirectory=flying-certs
ReadWritePaths=/var/lib/flying-certs /var/log/flying-certs

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
